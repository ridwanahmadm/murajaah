# Only free, local AI is supported. Paid/cloud providers are blocked.
AI_PROVIDER=ollama
# Set an explicitly tagged local vision model (see README); no hardcoded fallback.
AI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set on the Ollama server process too, to disable all Ollama cloud features.
OLLAMA_NO_CLOUD=1
# Kept for configuration compatibility; never used or transmitted.
AI_API_KEY=
# Private random code, at least 24 characters; enter once in Pengaturan.
APP_ACCESS_CODE=
